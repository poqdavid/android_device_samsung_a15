# mount point	fstype		device					device2			flags

# Physical partitions
/boot		emmc		/dev/block/by-name/boot						flags=backup=1;flashimg=1;display="Boot"
/recovery	emmc		/dev/block/by-name/recovery					flags=backup=1;flashimg=1;display="Recovery"
/vendor_boot	emmc		/dev/block/by-name/vendor_boot					flags=backup=1;flashimg=1;display="Vendor Boot"
/dtbo		emmc		/dev/block/by-name/dtbo						flags=backup=1;flashimg=1;display="Dtbo"
/vbmeta		emmc		/dev/block/by-name/vbmeta					flags=backup=1;flashimg=1;display="Vbmeta"
/vbmeta_system	emmc		/dev/block/by-name/vbmeta_system				flags=backup=1;flashimg=1;display="Vbmeta System"
/vbmeta_vendor	emmc		/dev/block/by-name/vbmeta_vendor				flags=backup=1;flashimg=1;display="Vbmeta Vendor"
/metadata	ext4		/dev/block/by-name/metadata					flags=backup=1;wipeingui;display="Metadata"
/cache		ext4		/dev/block/by-name/cache					flags=display="Cache"

# IMEI and calibration data (backup only)
# As in Android: efs is /mnt/vendor/efs, sec_efs is /efs
/efs		ext4		/dev/block/by-name/efs						flags=backup=1;display="EFS"
/sec_efs	ext4		/dev/block/by-name/sec_efs					flags=backup=1;display="Sec EFS"
/nvram		emmc		/dev/block/by-name/nvram					flags=backup=1;display="NVRAM"
/nvdata		ext4		/dev/block/by-name/nvdata					flags=backup=1;display="NVDATA"
/nvcfg		ext4		/dev/block/by-name/nvcfg					flags=backup=1;display="NVCFG"
/protect_f	ext4		/dev/block/by-name/protect1					flags=backup=1;display="Protect_f"
/protect_s	ext4		/dev/block/by-name/protect2					flags=backup=1;display="Protect_s"
/proinfo	emmc		/dev/block/by-name/proinfo					flags=backup=1;display="Proinfo"

# Removable storage
/storage	auto		/data/media/0							flags=backup=1;display="Internal Storage";usermrf;fsflags="bind,utf8";removable
/sdcard1	auto		/dev/block/mmcblk0p1			/dev/block/mmcblk0	flags=display="MicroSD";storage;wipeingui;removable
/usb_otg	auto		/dev/block/sdd1				/dev/block/sdd		flags=fsflags=utf8;display="USB-Storage";storage;wipeingui;removable
#
