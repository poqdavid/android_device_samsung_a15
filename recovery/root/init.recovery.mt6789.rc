import /init.recovery.teegris.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0

on post-fs
    # Load the SoC temperature sensor and link /tmp/cpu_temp to it before
    # OrangeFox starts (see cpu_temp.sh)
    exec u:r:recovery:s0 root root -- /system/bin/cpu_temp.sh
    # Bring up Zinitix touch before OrangeFox starts: load the driver before
    # the installed vendor with its firmware file is mounted, and turn the
    # display off and on while OrangeFox does not hold it yet (see
    # zinitix_touch.sh)
    exec u:r:recovery:s0 root root -- /system/bin/zinitix_touch.sh
    # OrangeFox's flashlight (OF_FL_PATH1) drives a LED class style
    # directory: brightness, up to max_brightness. The torch here is
    # Samsung's rear_flash file instead, which takes 1 for on and 0 for off,
    # so give OrangeFox a directory where max_brightness is 1 and brightness
    # is rear_flash, as the a55x tree does. rear_flash only appears once
    # OrangeFox has loaded leds-sm5714-fled.ko; the link points nowhere
    # until then.
    mkdir /tmp/flashlight 0755 root root
    write /tmp/flashlight/max_brightness 1
    symlink /sys/class/camera/flash/rear_flash /tmp/flashlight/brightness

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd
